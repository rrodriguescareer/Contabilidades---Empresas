NEXT_PUBLIC_SUPABASE_URL=https://rllajahyovpzndbbyvcd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternatively: NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://portal.rr-contabilidade.com
NEXT_PUBLIC_IRS_URL=https://irs.rr-contabilidade.com
NEXT_PUBLIC_GESTAO_URL=https://gestao.rr-contabilidade.com

# Private server-only configuration. Never prefix these names with NEXT_PUBLIC_.
# Reads the Cegid credentials of each company and keeps the report cache.
SUPABASE_SECRET_KEY=
# Same 64-hex key as IRS and Gestão: decrypts the per-company Cegid credentials.
INTEGRATION_ENCRYPTION_KEY=
# Resend: notifies the accountant of new documents and messages.
RESEND_API_KEY=
# Optional. Defaults to "Rúben Meirinho Rodrigues <portal@rr-contabilidade.com>".
MAIL_FROM=
# Optional. Where accountant notifications go.
EMAIL_GABINETE=
# Optional Cegid endpoints (defaults to the production Cegid Business PT).
CEGID_OAUTH_URL=
CEGID_API_URL=
CEGID_REDIRECT_URI=
# Set true once Supabase sends branded recovery emails (as in the other apps).
AUTH_EMAIL_BRANDING_READY=false
